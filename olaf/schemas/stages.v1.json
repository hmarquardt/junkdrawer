{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "OLAF Phase 2 staged observation contracts. Each property below is an independent stage schema. Version 1.0. Local $ref entries are expanded before strict structured-output requests.",
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "pairText": {
      "type": "object",
      "properties": {
        "Left": { "$ref": "#/$defs/text" },
        "Right": { "$ref": "#/$defs/text" }
      },
      "required": ["Left", "Right"],
      "additionalProperties": false
    },
    "pairConfidence": {
      "type": "object",
      "properties": {
        "Left": { "enum": ["high", "medium", "low"] },
        "Right": { "enum": ["high", "medium", "low"] }
      },
      "required": ["Left", "Right"],
      "additionalProperties": false
    },
    "pairStatus": {
      "type": "object",
      "properties": {
        "Left": { "enum": ["met", "alternative", "missing", "uncertain", "excluded"] },
        "Right": { "enum": ["met", "alternative", "missing", "uncertain", "excluded"] }
      },
      "required": ["Left", "Right"],
      "additionalProperties": false
    }
  },
  "compile": {
    "type": "object",
    "properties": {
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
            "excerpt": { "$ref": "#/$defs/text" },
            "kind": {
              "enum": ["component", "style", "content", "layout", "functionality", "later_state", "ambiguous"]
            },
            "scope": { "enum": ["visible", "unobservable", "later", "uncertain"] },
            "check": { "$ref": "#/$defs/text" },
            "confidence": { "enum": ["high", "medium", "low"] }
          },
          "required": ["id", "excerpt", "kind", "scope", "check", "confidence"],
          "additionalProperties": false
        }
      }
    },
    "required": ["requirements"],
    "additionalProperties": false
  },
  "adherence": {
    "type": "object",
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
            "status": { "$ref": "#/$defs/pairStatus" },
            "evidence": { "$ref": "#/$defs/pairText" },
            "basis": { "$ref": "#/$defs/pairText" },
            "alternative": {
              "type": "object",
              "properties": {
                "Left": { "type": "boolean" },
                "Right": { "type": "boolean" }
              },
              "required": ["Left", "Right"],
              "additionalProperties": false
            },
            "confidence": { "$ref": "#/$defs/pairConfidence" }
          },
          "required": ["id", "status", "evidence", "basis", "alternative", "confidence"],
          "additionalProperties": false
        }
      }
    },
    "required": ["results"],
    "additionalProperties": false
  },
  "inspection": {
    "type": "object",
    "properties": {
      "rendering": {
        "type": "object",
        "properties": {
          "Left": { "enum": ["rendered", "failed", "uncertain"] },
          "Right": { "enum": ["rendered", "failed", "uncertain"] }
        },
        "required": ["Left", "Right"],
        "additionalProperties": false
      },
      "renderEvidence": { "$ref": "#/$defs/pairText" },
      "passes": {
        "type": "object",
        "properties": {
          "first_look": { "$ref": "#/$defs/pairText" },
          "structure": { "$ref": "#/$defs/pairText" },
          "type": { "$ref": "#/$defs/pairText" },
          "color": { "$ref": "#/$defs/pairText" },
          "details": { "$ref": "#/$defs/pairText" }
        },
        "required": ["first_look", "structure", "type", "color", "details"],
        "additionalProperties": false
      },
      "principles": {
        "type": "object",
        "properties": {
          "hierarchy": { "$ref": "#/$defs/pairText" },
          "grid": { "$ref": "#/$defs/pairText" },
          "spacing": { "$ref": "#/$defs/pairText" },
          "alignment": { "$ref": "#/$defs/pairText" },
          "typography": { "$ref": "#/$defs/pairText" },
          "color": { "$ref": "#/$defs/pairText" },
          "contrast": { "$ref": "#/$defs/pairText" },
          "consistency": { "$ref": "#/$defs/pairText" }
        },
        "required": [
          "hierarchy",
          "grid",
          "spacing",
          "alignment",
          "typography",
          "color",
          "contrast",
          "consistency"
        ],
        "additionalProperties": false
      },
      "defects": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "side": { "enum": ["Left", "Right"] },
            "type": { "enum": ["overlap", "clipping", "imagery", "alignment", "layout", "contrast"] },
            "severity": { "enum": ["minor", "major", "page_broken"] },
            "location": { "$ref": "#/$defs/text" },
            "scope": { "enum": ["localized", "widespread", "page"] },
            "impact": { "enum": ["cosmetic", "obstructive", "unreadable"] },
            "evidence": { "$ref": "#/$defs/pairText" }
          },
          "required": ["side", "type", "severity", "location", "scope", "impact", "evidence"],
          "additionalProperties": false
        }
      },
      "lessAffected": { "enum": ["Left", "Right", "comparable", "uncertain"] },
      "impactEvidence": { "$ref": "#/$defs/pairText" },
      "confidence": { "enum": ["high", "medium", "low"] },
      "limitations": { "type": "array", "items": { "$ref": "#/$defs/text" } },
      "inferences": { "type": "array", "items": { "$ref": "#/$defs/text" } }
    },
    "required": [
      "rendering",
      "renderEvidence",
      "passes",
      "principles",
      "defects",
      "lessAffected",
      "impactEvidence",
      "confidence",
      "limitations",
      "inferences"
    ],
    "additionalProperties": false
  },
  "preference": {
    "type": "object",
    "properties": {
      "preference": { "enum": ["Left", "Right", "Tie", "uncertain"] },
      "preferenceEvidence": { "$ref": "#/$defs/pairText" },
      "tieQuality": { "enum": ["good", "bad"] },
      "confidence": { "enum": ["high", "medium", "low"] },
      "limitations": { "type": "array", "items": { "$ref": "#/$defs/text" } }
    },
    "required": ["preference", "preferenceEvidence", "tieQuality", "confidence", "limitations"],
    "additionalProperties": false
  },
  "verify": {
    "type": "object",
    "properties": {
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "target": { "$ref": "#/$defs/text" },
            "verdict": { "enum": ["confirmed", "refuted", "uncertain"] },
            "suggested": { "type": "string" },
            "evidence": { "$ref": "#/$defs/pairText" },
            "note": { "type": "string" }
          },
          "required": ["target", "verdict", "suggested", "evidence", "note"],
          "additionalProperties": false
        }
      }
    },
    "required": ["checks"],
    "additionalProperties": false
  }
}
