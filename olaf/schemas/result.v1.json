{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "rubricVersion": {
      "const": "1.1"
    },
    "candidateIds": {
      "type": "object",
      "properties": {
        "Left": {
          "type": "string",
          "minLength": 1
        },
        "Right": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "Left",
        "Right"
      ],
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "Left",
        "Right",
        "Tie",
        "REVIEW"
      ]
    },
    "stage": {
      "enum": [
        "rendering",
        "prompt_adherence",
        "disqualifiers",
        "preference",
        "tie",
        "review"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "properties": {
        "Left": {
          "type": "string",
          "minLength": 1
        },
        "Right": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "Left",
        "Right"
      ],
      "additionalProperties": false
    },
    "observation": {
      "$ref": "perception.v1.json"
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "inputTokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "estimatedUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "provider",
        "model",
        "latencyMs",
        "inputTokens",
        "outputTokens",
        "estimatedUsd"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "reversedDecision": {
          "enum": [
            "Left",
            "Right",
            "Tie",
            "REVIEW"
          ]
        },
        "mappedDecision": {
          "enum": [
            "Left",
            "Right",
            "Tie",
            "REVIEW"
          ]
        },
        "reversedStage": {
          "enum": [
            "rendering",
            "prompt_adherence",
            "disqualifiers",
            "preference",
            "tie",
            "review"
          ]
        },
        "consistent": {
          "type": "boolean"
        },
        "candidateIds": {
          "type": "object",
          "properties": {
            "Left": {
              "type": "string",
              "minLength": 1
            },
            "Right": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "Left",
            "Right"
          ],
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "latencyMs": {
              "type": "number",
              "minimum": 0
            },
            "inputTokens": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "outputTokens": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "estimatedUsd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "provider",
            "model",
            "latencyMs",
            "inputTokens",
            "outputTokens",
            "estimatedUsd"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "reversedDecision",
        "mappedDecision",
        "reversedStage",
        "consistent",
        "candidateIds",
        "telemetry"
      ],
      "additionalProperties": false
    },
    "captureScope": {
      "enum": [
        "unknown",
        "full_page",
        "viewport",
        "specific_screen"
      ]
    },
    "captures": {
      "type": "object",
      "properties": {
        "Left": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "mime": {
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp"
              ]
            }
          },
          "required": [
            "width",
            "height",
            "mime"
          ],
          "additionalProperties": false
        },
        "Right": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "mime": {
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp"
              ]
            }
          },
          "required": [
            "width",
            "height",
            "mime"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Left",
        "Right"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "taskId",
    "rubricVersion",
    "candidateIds",
    "decision",
    "stage",
    "confidence",
    "why",
    "evidence",
    "observation",
    "telemetry",
    "captureScope",
    "captures"
  ],
  "additionalProperties": false
}
