{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "object",
      "properties": {
        "Left": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "mime": {
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp"
              ]
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "enum": [
                "file",
                "clipboard",
                "archive",
                "crop",
                "synthetic",
                "mixed"
              ]
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "width",
            "height",
            "mime",
            "bytes",
            "source",
            "provenance",
            "sha256"
          ],
          "additionalProperties": false
        },
        "Right": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "mime": {
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp"
              ]
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "enum": [
                "file",
                "clipboard",
                "archive",
                "crop",
                "synthetic",
                "mixed"
              ]
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "width",
            "height",
            "mime",
            "bytes",
            "source",
            "provenance",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Left",
        "Right"
      ],
      "additionalProperties": false
    },
    "source": {
      "enum": [
        "file",
        "clipboard",
        "archive",
        "crop",
        "synthetic",
        "mixed"
      ]
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rubricVersion": {
      "const": "1.1"
    },
    "captureScope": {
      "enum": [
        "unknown",
        "full_page",
        "viewport",
        "specific_screen"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "id",
    "request",
    "images",
    "source",
    "provenance",
    "warnings",
    "rubricVersion",
    "captureScope"
  ],
  "additionalProperties": false
}
