  "tutorials": [
    {
      "id": "pore-explorer:enter",
      "title": "Entering the underground",
      "steps": [
        "Pick a target, then open the PoreScope panel under the case brief.",
        "Scan mode is interactive: sweep the beam over the lesion and hold to gain depth. Nothing is revealed all at once.",
        "Cross-section mode shows the chambers, the connections and whatever is blocking them.",
        "Concealed chambers must be found before they can be drained. Draining the chamber in front can also expose them."
      ]
    },
    {
      "id": "pore-explorer:tut-scope",
      "title": "Reading the PoreScope",
      "equipment": "pore-explorer:scope",
      "steps": [
        "Equipped as an instrument, the PoreScope sweeps faster and reaches deeper than a borrowed camera.",
        "A release with the PoreScope is a diagnostic pulse. It reveals and it breaks nothing.",
        "Chamber outlines dim as they empty. Dashed links are blocked by a valve or a plug.",
        "Swap to an extraction instrument when you know the layout."
      ]
    },
    {
      "id": "pore-explorer:tut-vortex",
      "title": "Running the vortex",
      "equipment": "pore-explorer:vortex",
      "steps": [
        "The Vortex Extractor drains two flow units per release: fast on open networks.",
        "Its release window is very narrow. Lean the instrument to steer the twin stream.",
        "It cannot break a valve or a plug. If the imaging shows a dashed link, bring the wand instead."
      ]
    },
    {
      "id": "pore-explorer:tut-wand",
      "title": "Tuning the wand",
      "equipment": "pore-explorer:wand",
      "steps": [
        "The Resonance Wand breaks one obstruction per release: valves, septa and migrating plugs.",
        "It cannot grip ordinary material. With nothing to resonate the release is refused and costs nothing.",
        "Use it to open a path, then extract with a tool that actually holds on."
      ]
    },
    {
      "id": "pore-explorer:deep",
      "title": "Layered cases",
      "steps": [
        "Layered reservoirs change material mid-case. The expelled colour tells you which chamber is draining.",
        "Hubs cascade: finishing one wakes its neighbours. Scan first so a cascade lands somewhere useful.",
        "A migrating plug blocks a different chamber on every pass. The scope marks it in amber."
      ]
    }
  ]
