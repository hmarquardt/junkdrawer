  "tutorials": [
    {
      "id": "disgusting-day-spa:tut-spa",
      "title": "Opening the Day Spa",
      "steps": [
        "The Day Spa is a management mode. Appointments you perform personally open the normal extraction simulation with the same instruments, telemetry and records.",
        "Advance the day when you are ready: rent, wages, marketing and maintenance are charged then, and the next queue is generated from the business seed.",
        "Every payment is a ledger entry with a unique id. Completing an appointment or closing a day twice cannot pay you twice.",
        "Routine appointments can be delegated once you hire a technician. Delegated cases never set extraction records.",
        "The Midnight Wing unlocks at tier 5 and uses the existing Midnight Clinic classes and materials."
      ]
    }
  ],
