  "reviewLines": [
    {
      "id": "disgusting-day-spa:rev-five",
      "stars": 5,
      "text": "Five stars. I feel approximately three pounds lighter."
    },
    {
      "id": "disgusting-day-spa:rev-five-2",
      "stars": 5,
      "text": "Excellent service. I came in with a blackhead and left with a geological survey."
    },
    {
      "id": "disgusting-day-spa:rev-five-3",
      "stars": 5,
      "text": "Very discreet. Particularly important when you are technically deceased."
    },
    {
      "id": "disgusting-day-spa:rev-four",
      "stars": 4,
      "text": "She said there was more. There was considerably more."
    },
    {
      "id": "disgusting-day-spa:rev-four-2",
      "stars": 4,
      "text": "Would recommend, although I have been unable to stop watching the replay."
    },
    {
      "id": "disgusting-day-spa:rev-five-4",
      "stars": 5,
      "text": "I have been alive for 600 years and this was the first appointment that started on time."
    },
    {
      "id": "disgusting-day-spa:rev-three",
      "stars": 3,
      "text": "Professional, thorough, and slightly too interested in the sample."
    },
    {
      "id": "disgusting-day-spa:rev-two",
      "stars": 2,
      "text": "The extraction was fine. The waiting room had a werewolf."
    },
    {
      "id": "disgusting-day-spa:rev-one",
      "stars": 1,
      "text": "I was charged for geology. I came here for skincare."
    },
    {
      "id": "disgusting-day-spa:rev-legend",
      "stars": 5,
      "text": "They had to call someone else in to finish it. Magnificent."
    }
  ],
